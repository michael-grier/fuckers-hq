DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=
CRON_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_USER_IDS=
SHIPPING_ALLOWED_COUNTRIES=CA,US
SHIPPING_STANDARD_RATE_CENTS=
# Leave unset for flat-rate shipping. Setting it makes orders at or above the amount ship free.
SHIPPING_FREE_THRESHOLD_CENTS=
# Local pickup is offered only when PICKUP_ENABLED is true and the name, address, and hours are
# all set. PICKUP_ADDRESS may contain newlines to break the address across lines.
PICKUP_ENABLED=false
PICKUP_LOCATION_NAME=
PICKUP_ADDRESS=
PICKUP_HOURS=
PICKUP_INSTRUCTIONS=

# Per-worktree Neon branch databases (`bun run setup:worktree`, see scripts/worktree-db.ts).
# When both the API key and project id are set, each linked git worktree gets its own Neon
# branch named after its git branch, so migration lineages cannot collide through the shared
# DATABASE_URL. Leave empty to keep sharing one database. NEON_PARENT_BRANCH_ID is optional:
# new branches otherwise fork the branch the shared DATABASE_URL points at.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_PARENT_BRANCH_ID=
