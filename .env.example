DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=
CRON_SECRET=
# Every environment with its own database (production, shared dev) must also have its own R2
# bucket and public URL. The nightly orphaned-image reaper deletes any bucket object its own
# database does not reference, so pointing two databases at one bucket lets production's reaper
# delete objects that only the other environment references.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_USER_IDS=
# Comma-separated ISO alpha-2 codes. Must match what the shipping policy page tells customers.
SHIPPING_ALLOWED_COUNTRIES=CA
# Leave unset for flat-rate shipping. Setting it makes orders at or above the amount ship free.
SHIPPING_FREE_THRESHOLD_CENTS=
# Search indexing is opt-in. Leave false until the store can take a real payment; every other
# value of this flag risks the domain being indexed while it is still being set up.
ALLOW_INDEXING=false
# Local delivery is offered only when DELIVERY_ENABLED is true and the service area is named
# (e.g. "Rocky View County, Alberta"). The area is stated at checkout; the delivery address is
# collected by Stripe and verified by the operator when arranging the drop-off.
DELIVERY_ENABLED=false
DELIVERY_AREA_NAME=
DELIVERY_INSTRUCTIONS=

# Per-worktree Neon branch databases (`bun run setup:worktree`, see scripts/worktree-db.ts).
# When both the API key and project id are set, each linked git worktree gets its own Neon
# branch named after its git branch, so migration lineages cannot collide through the shared
# DATABASE_URL. Leave empty to keep sharing one database. NEON_PARENT_BRANCH_ID is optional:
# new branches otherwise fork the branch the shared DATABASE_URL points at.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_PARENT_BRANCH_ID=

# The live e2e tier (`bun run test:e2e:live`) additionally needs the Stripe CLI installed and
# STRIPE_WEBHOOK_SECRET matching the CLI listener's whsec_... value.
# E2E seeding opt-in (`bun run test:e2e`, see e2e/setup/global-setup.ts). The suite seeds and
# mutates its database, so it refuses to run unless this names the exact DATABASE_URL of a
# disposable test database. `setup:worktree` writes it into the generated worktree overrides;
# set it manually only when deliberately pointing e2e at some other test database.
E2E_DATABASE_URL=
# Email of the dedicated e2e admin user in the Clerk *development* instance. The admin e2e tier
# signs this user in via @clerk/testing; its user_... id must also be in ADMIN_USER_IDS.
E2E_CLERK_USER_EMAIL=
