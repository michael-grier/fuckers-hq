{
  "name": "fuckers-hq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "bun run db:verify-production-target && next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:live": "E2E_STRIPE_LIVE=1 playwright test --project=live",
    "visual-check": "bun scripts/visual-check.ts",
    "setup:worktree": "bash scripts/setup-worktree.sh",
    "teardown:worktree": "bun scripts/worktree-db.ts teardown",
    "worktree:prune": "bun scripts/worktree-db.ts prune",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run lib/db/migrate.ts",
    "db:verify-production-target": "bun scripts/verify-production-database.ts",
    "db:seed": "bun run lib/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@clerk/nextjs": "^7.9.22",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-email/components": "^0.5.7",
    "@sentry/nextjs": "10.76.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.550.0",
    "next": "^16.4.3",
    "nuqs": "^2.10.2",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.90.0",
    "resend": "^6.34.1",
    "stripe": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@clerk/backend": "3.26.4",
    "@clerk/testing": "^2.2.52",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "browserslist": "4.29.4",
    "fast-uri": "3.1.9",
    "nanoid": "3.3.20",
    "postcss": "8.5.31",
    "qs": "6.16.1",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
